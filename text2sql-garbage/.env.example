# .env.example —— 仅作模板，复制为 .env 后填真实值（.env 已被 gitignore，禁止入库）
#
# ── 本地开发（Postgres 在本机）──
MODEL_NAME=deepseek-flash
API_KEY=your-deepseek-key
BASE_URL=https://api.deepseek.com
DATABASE_URL=postgresql://postgres:root@localhost:5432/garbage_db

# ── 阿里云 OSS 配置（当前未启用，导出走本地 exceljs，见 memory）──
OSS_REGION=your-region
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# ── 部署到 Netlify + Supabase 时，下方变量在 Netlify 控制台设置（不写本文件）──
# DATABASE_URL 用 Supabase Transaction pooler 连接串（带 ?sslmode=require&pgbouncer=true），
# pg 原生支持 sslmode，db.ts 无需改。示例：
#   DATABASE_URL=postgresql://postgres.xxxx:6543/postgres?sslmode=require&pgbouncer=true
# API_KEY / BASE_URL / MODEL_NAME 与本地同值。
#
# ── CI / 部署 用的 GitHub Secrets（零入库）──
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL_NAME   → G7 评测门禁拉真实模型
#   NETLIFY_AUTH_TOKEN / NETLIFY_SITE_ID                         → Deploy 工作流推 Netlify
#   HOSTED_DATABASE_URL                                          → DB Setup 工作流灌 Supabase 云库
