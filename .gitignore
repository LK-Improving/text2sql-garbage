# ── 依赖 / 构建产物 ──
node_modules/
.pnp/
.pnp.js
.next/
out/
*.tsbuildinfo

# ── 密钥 / 环境变量（切勿提交）──
.env
.env.local
.env.*.local
# 部署到 Netlify 的线上环境变量（含真实密钥，仅本地留存，导入 Netlify 用）
.env.netlify
.env.netlify.local

# ── 运行时日志（审计日志为运行产物，可重建）──
logs/

# ── Excel 导出本地留存（FR5：exceljs 生成后服务端落盘一份，可重建）──
downloads/

# ── 杂项 ──
npm-debug.log*
*.log
.DS_Store

# ── 项目特定排除 ──
# WorkBuddy 截图产物（二进制，无需纳入版本控制）
.workbuddy/shots/
# create-next-app 初始 npm 残留锁文件（本项目使用 pnpm，以 pnpm-lock.yaml 为准）
package-lock.json
